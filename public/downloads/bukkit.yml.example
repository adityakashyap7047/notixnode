# Bukkit.yml Configuration Template
# Generated by NOTIXNODE — For Spigot/Paper 1.21.1
# Source: https://github.com/SpigotMC/Spigot/blob/master/bukkit.yml
# License: GNU GPL v3
# Documentation: https://www.spigotmc.org/wiki/bukkit-yml/

settings:
  # Allow /end command (dangerous!)
  allow-end: true
  
  # Warn when server is overloaded
  warn-on-overload: true
  
  # Permission system
  permissions-file: permissions.yml
  update-folder: update
  
  # Plugin profiling (disable in production)
  plugin-profiling: false
  
  # Connection throttle
  connection-throttle: 4000
  
  # Query settings (for server lists)
  query-plugins: true
  
  # Deprecated
  deprecated-verbose: default
  
  # Shutdown message
  shutdown-message: Server closed

spawn-limits:
  monsters: 70
  animals: 10
  water-ambient: 15
  water-animals: 5
  water-underground-creature: 5
  axolotls: 5
  ambient: 15
  misc: -1

chunk-gc:
  period-in-ticks: 600
  load-threshold: 0

ticks-per:
  animal-spawns: 400
  monster-spawns: 1
  autosave: 6000

aliases:
  # Example command aliases
  # "aliasname": "realcommand args"
  # "gm": "gamemode"
  # "heal": "effect give @p minecraft:instant_health"

commands:
  # Tab completion settings
  tab-complete: 0
  # Spam protection
  spam-exclusions:
    - /skill
    - /permission
    - /lp
  # Silent commands (don't broadcast to other players)
  silent-commands-acknowledgement: true
  # Timeout for command execution
  timeout: 30

worlds:
  # World-specific settings
  world:
    generator: ""
    environment: normal
  world_nether:
    generator: ""
    environment: nether
  world_the_end:
    generator: ""
    environment: the_end

# Advanced settings (use with caution)
# 
# auto-updater: false
# 
# # Console settings
# console:
#   enabled: true
# 
# # Plugin settings
# plugin-settings:
#   debug: false

---
# NOTES:
# - allow-end: Set to false to disable /end command (prevents accidental End dimension access)
# - connection-throttle: Milliseconds between connections from same IP (anti-bot)
# - query-plugins: Allows server lists to see plugin list (disable for privacy)
# - aliases: Define custom command shortcuts here
# - spam-exclusions: Commands that bypass chat spam protection
# - worlds: Define world generators and environments
# - chunk-gc.period-in-ticks: How often to unload unused chunks (600 = 30 seconds)
# - ticks-per.autosave: 6000 = 5 minutes (300 seconds at 20 TPS)
# - Full documentation: https://www.spigotmc.org/wiki/bukkit-yml/