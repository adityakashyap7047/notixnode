# Paper.yml Configuration Template
# Generated by NOTIXNODE — For Paper 1.21.1
# Source: https://github.com/PaperMC/Paper/blob/master/paper.yml
# License: PaperMC License (based on GNU GPL v3)
# Documentation: https://docs.papermc.io/paper/reference/paper-yml

verbose: false
config-version: 33

# --- Performance Settings ---
use-faster-eigencraft-redstone: true
max-auto-save-chunks-per-tick: 24
optimize-explosions: true
update-pathfinding-on-block-update: true
max-chunk-generation-threads: 1

# --- Entity & Mob Settings ---
entity-activation-range:
  animals: 32
  monsters: 32
  raiders: 48
  misc: 16
  water: 16
  villagers: 32
  flying-monsters: 48

entity-tracking-range:
  players: 48
  animals: 48
  monsters: 48
  misc: 32
  other: 64

# --- Hopper Optimization ---
hopper:
  disable-move-event: true
  ignore-occluding-blocks: true
  cooldown-when-full: true
  push-based: false

# --- Container & Inventory ---
container-update-tick-rate: 1
auto-replenish: false

# --- Map & Item Frame ---
map-item-frame-cursor-limit: 128
max-entity-collisions: 8

# --- Grass & Mycelium Spread ---
grass-spread-tick-rate: 4
mob-spawner-tick-rate: 4

# --- Despawn Ranges ---
despawn-ranges:
  soft: 32
  hard: 128

# --- Tick Rates ---
ticks-per:
  animal-spawns: 400
  monster-spawns: 1
  autosave: 6000

# --- Nether & End ---
disable-nether-ceiling-spawning: true
enable-gen-buckets: true

# --- Chunk Loading ---
prevent-moving-into-unloaded-chunks: true
keep-spawn-loaded: true
keep-spawn-loaded-range: 10

# --- Anti-XRay ---
anti-xray:
  enabled: true
  engine-mode: 2
  hide-blocks:
    - DIAMOND_ORE
    - DEEPSLATE_DIAMOND_ORE
    - EMERALD_ORE
    - DEEPSLATE_EMERALD_ORE
    - ANCIENT_DEBRIS
  replace-blocks:
    - STONE
    - DEEPSLATE
    - NETHERRACK
    - END_STONE

# --- Other ---
allow-permanent-chunk-loaders: false
disable-chest-cat-detection: true
disable-player-crits: false
disable-sprint-interruption-on-attack: false
ender-pearls-vanish-on-death: true
fix-curing-zombie-villager-discount: true
fix-items-merging-through-walls: true
remove-corrupted-tile-entities: true
use-faster-eigencraft-redstone: true

# --- Logging ---
log-villager-deaths: false
log-player-ip-addresses: false

# --- Experimental ---
alt-item-despawn-rate:
  enabled: false
faster-redstone:
  enabled: false

---
# NOTES:
# - Review entity-activation-range for your server type (lower for minigames, higher for survival)
# - Test hopper changes with auto-farms
# - anti-xray engine-mode 2 is more performant but uses more RAM
# - Keep config-version updated when upgrading Paper
# - Full documentation: https://docs.papermc.io/paper/reference/paper-yml