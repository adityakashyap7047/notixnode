# Spigot.yml Configuration Template
# Generated by NOTIXNODE — For Spigot/Paper 1.21.1
# Source: https://github.com/SpigotMC/Spigot/blob/master/spigot.yml
# License: GNU GPL v3
# Documentation: https://www.spigotmc.org/wiki/spigot-yml/

config-version: 13

settings:
  # BungeeCord/Velocity support
  bungeecord: false
  
  # Save structure on shutdown (prevents corruption)
  save-structure-on-shutdown: true
  
  # User cache size (player data)
  user-cache-size: 1000
  user-cache: true
  
  # Int cache for block states
  int-cache-limit: 1024
  
  # Move threshold for packet sending (lower = more precise, higher = less bandwidth)
  moved-wrongly-threshold: 0.0625
  moved-too-quickly-threshold: 100.0
  
  # Timeout settings
  timeout-time: 60
  restart-on-crash: true
  restart-script: ./start.sh
  
  # Netty settings
  netty-threads: 4
  
  # Player activity
  player-shuffle: 0
  
  # Book limits
  max-book-pages: 100
  max-book-length: 2560
  
  # Command settings
  commands-tab-completion: true
  log-named-deaths: true
  
  # Attribute settings
  attribute:
    max-health: 2048.0
    max-absorption: 2048.0
    max-attack-damage: 2048.0
    max-attack-speed: 1024.0
    max-armor: 2048.0
    max-armor-toughness: 2048.0
    max-attack-knockback: 2048.0
    max-flying-speed: 1024.0
    max-follow-range: 2048.0
    max-knockback-resistance: 2048.0
    max-luck: 1024.0
    max-movement-speed: 2048.0
    max-spawn-reinforcements: 2048.0
    max-step-height: 2048.0
    max-water-movement-efficiency: 2048.0

  # Entity tracking
  entity-tracking-range:
    players: 48
    animals: 48
    monsters: 48
    misc: 32
    other: 64
  
  # Entity activation
  entity-activation-range:
    animals: 32
    monsters: 32
    raiders: 48
    misc: 16
    water: 16
    villagers: 32
    flying-monsters: 48
  
  # Tick intervals
  ticks-per:
    animal-spawns: 400
    monster-spawns: 1
    water-spawns: 1
    ambient-spawns: 1
    autosave: 6000
  
  # Chunk settings
  chunk-load-thread-count: 1
  chunk-gc.period-in-ticks: 600
  
  # Spawn limits
  spawn-limits:
    monsters: 70
    animals: 10
    water-ambient: 15
    water-animals: 5
    ambient: 15
    axolotls: 5
    underground-water-creature: 5
    water-creature: 5
    misc: -1

messages:
  whitelist: You are not whitelisted on this server!
  unknown-command: Unknown command. Type "/help" for help.
  server-full: The server is full!
  outdated-client: Outdated client! Please use {0}
  outdated-server: Outdated server! I'm still on {0}
  restart: Server is restarting

stats:
  disable-saving: false
  forced-stats: {}

advancements:
  disable-saving: false
  disable-listener: false

world-settings:
  default:
    # Verbose logging
    verbose: false
    
    # Entity settings
    entity-tracking-range:
      players: 48
      animals: 48
      monsters: 48
      misc: 32
      other: 64
    
    entity-activation-range:
      animals: 32
      monsters: 32
      raiders: 48
      misc: 16
      water: 16
      villagers: 32
      flying-monsters: 48
    
    # Hopper settings
    hopper-amount: 1
    hopper-transfer: 8
    hopper-cooldown: 0
    
    # Random light updates
    random-light-updates: false
    
    # Item despawn rates
    item-despawn-rate: 6000
    arrow-despawn-rate: 1200
    trident-despawn-rate: 1200
    
    # Zombie settings
    zombie-aggressive-towards-villager: true
    
    # Nerfing spawners
    nerf-spawner-mobs: false
    
    # Growth modifiers
    cactus-growth-modifier: 100%
    cane-growth-modifier: 100%
    melon-growth-modifier: 100%
    mushroom-growth-modifier: 100%
    pumpkin-growth-modifier: 100%
    sapling-growth-modifier: 100%
    beetroot-growth-modifier: 100%
    carrot-growth-modifier: 100%
    potato-growth-modifier: 100%
    wheat-growth-modifier: 100%
    nether-wart-growth-modifier: 100%
    vine-growth-modifier: 100%
    cocoa-growth-modifier: 100%
    bamboo-growth-modifier: 100%
    kelp-growth-modifier: 100%
    twisting-vines-growth-modifier: 100%
    weeping-vines-growth-modifier: 100%
    hanging-roots-growth-modifier: 100%
    amethyst-bud-growth-modifier: 100%
    
    # Mob spawning
    mob-spawn-range: 8
    
    # Container settings
    container-update-tick-rate: 1
    
    # Hunger
    hunger.walk-exhaustion: 0.2
    hunger.sprint-exhaustion: 0.8
    hunger.combat-exhaustion: 0.3
    hunger.regen-exhaustion: 3.0
    
    # Entity per chunk limits
    max-entity-collisions: 8
    
    # Experience merge
    exp-merge-max-value: -1
    
    # Water over lava
    water-over-lava-flow-speed: 5
    
    # Tick settings
    max-tick-time:
      tile: 50
      entity: 50
    
    # Hopper optimization
    hopper:
      disable-move-event: true
      ignore-occluding-blocks: true
      cooldown-when-full: true
      push-based: false
    
    # Optimization
    optimize-explosions: true
    use-faster-eigencraft-redstone: true
    
    # Chunk settings
    keep-spawn-loaded: true
    keep-spawn-loaded-range: 10
    
    # Auto-save
    auto-save-interval: 6000
    
    # Entity removal
    remove-corrupted-tile-entities: true
    remove-entity-when-no-tick: false
    
    # Despawn ranges
    despawn-ranges:
      soft: 32
      hard: 128
    
    # Redstone
    disable-redstone-dust-tick: false
    disable-redstone-torch-tick: false
    
    # Grass spread
    grass-spread-tick-rate: 4
    
    # Mob spawner
    mob-spawner-tick-rate: 4
    
    # Sponge
    sponge-absorption-radius: 5
    
    # Enderman
    enderman-height: 2.9
    
    # TNT
    tnt-entity-height-nerf: false
    
    # Parity
    java-parity: true

---
# NOTES:
# - This config works for both Spigot and Paper (Paper overrides many settings via paper.yml)
# - entity-activation-range: Lower for performance, higher for natural behavior
# - hopper: disable-move-event saves significant CPU on hopper-heavy servers
# - ticks-per.monster-spawns: 1 = every tick (vanilla), higher = fewer spawns
# - max-tick-time: Increase if getting watchdog crashes (60000 default in vanilla)
# - growth-modifiers: 100% = vanilla speed, adjust for economy balance
# - Full documentation: https://www.spigotmc.org/wiki/spigot-yml/